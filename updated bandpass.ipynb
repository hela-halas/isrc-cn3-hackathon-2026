    "import numpy as np\n",
    "channels = [2, 3, 4]\n",
    "\n",
    "channel_data = {}\n",
    "\n",
    "for channel in channels:\n",
    "    # Get channel data\n",
    "    data = eeg_data.iloc[:, channel].to_numpy()\n",
    "\n",
    "    # Convert ADC digital values to µV\n",
    "    data = np.round(1000000 * 4.5 * (data / 16777215), 2)\n",
    "\n",
    "    # Store it\n",
    "    channel_data[channel] = data\n",
    "\n",
    "    # Plot\n",
    "    plt.figure()\n",
    "    plt.plot(data)\n",
    "    plt.title(\"EEG Raw Data, Channel \" + str(channel - 1))\n",
    "    plt.ylabel(\"EEG, µV\")\n",
    "    plt.xlabel(\"Sample\")\n",
    "    plt.show()"
   ]
  },
